<domain type="kvm">
  <name>wiresx</name>
  <uuid>84baff84-19e0-4bc7-bc42-7f5a4e81dc60</uuid>
  <title>Windows 11 Pro (license slot)</title>
  <description>Windows 11 Pro license slot.</description>
  <memory unit="MiB">8192</memory>
  <vcpu placement="static">4</vcpu>
  <os firmware="efi">
    <type arch="x86_64" machine="pc-q35-8.2">hvm</type>
    <firmware>
      <feature enabled="yes" name="enrolled-keys"></feature>
      <feature enabled="yes" name="secure-boot"></feature>
    </firmware>
    <boot dev="hd"></boot>
  </os>
  <features>
    <acpi></acpi>
    <apic></apic>
    <hyperv mode="custom">
      <relaxed state="on"></relaxed>
      <vapic state="on"></vapic>
      <spinlocks state="on" retries="8191"></spinlocks>
    </hyperv>
    <smm state="on"></smm>
  </features>
  <cpu match="exact" mode="custom" check="partial">
    <model fallback="forbid">IvyBridge-IBRS</model>
    <topology sockets="1" dies="1" cores="4" threads="1"></topology>
    <feature policy="optional" name="pcid"></feature>
    <feature policy="optional" name="md-clear"></feature>
    <feature policy="optional" name="stibp"></feature>
    <feature policy="optional" name="ssbd"></feature>
  </cpu>
  <clock offset="localtime">
    <timer name="rtc" tickpolicy="catchup"></timer>
    <timer name="pit" tickpolicy="delay"></timer>
    <timer name="hpet" present="no"></timer>
    <timer name="hypervclock" present="yes"></timer>
  </clock>
  <pm>
    <suspend-to-mem enabled="no"></suspend-to-mem>
    <suspend-to-disk enabled="no"></suspend-to-disk>
  </pm>
  <devices>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" cache="none" io="native" discard="unmap"></driver>
      <source file="/var/lib/winslot/disks/wiresx.qcow2"></source>
      <target dev="sda" bus="scsi"></target>
      <serial>WSFB990FA6376A67</serial>
      <wwn>5525400f628e4351</wwn>
    </disk>
    <controller type="scsi" index="0" model="virtio-scsi"></controller>
    <interface type="network">
      <mac address="52:54:00:09:a6:7b"></mac>
      <source network="default"></source>
      <model type="virtio"></model>
      <filterref filter="clean-traffic">
        <parameter name="CTRL_IP_LEARNING" value="dhcp"></parameter>
      </filterref>
    </interface>
    <serial type="file">
      <source path="/var/log/libvirt/qemu/wiresx.serial.log"></source>
      <target type="isa-serial" port="0"></target>
    </serial>
    <channel type="unix">
      <target type="virtio" name="org.qemu.guest_agent.0"></target>
    </channel>
    <tpm model="tpm-tis">
      <backend type="emulator" version="2.0"></backend>
    </tpm>
    <graphics type="vnc" port="-1" autoport="yes" listen="127.0.0.1"></graphics>
    <video>
      <model type="virtio" heads="1" primary="yes"></model>
    </video>
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>
  </devices>
</domain>
